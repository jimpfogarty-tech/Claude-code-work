# Copy to .env for local runs. In CI these come from GitHub Secrets.
# NEVER commit the real .env.

# The dedicated seed mailbox (NOT your primary address).
WARMUP_IMAP_HOST=imap.gmail.com
WARMUP_IMAP_PORT=993
WARMUP_IMAP_USER=your-seed-address@gmail.com

# Gmail App Password (16 chars, no spaces). Requires 2FA enabled on the account:
# https://myaccount.google.com/apppasswords
WARMUP_IMAP_PASSWORD=

# Optional: identity used when filling signup forms.
WARMUP_SIGNUP_FIRST_NAME=Seed
WARMUP_SIGNUP_LAST_NAME=Monitor
WARMUP_SIGNUP_ZIP=10001
